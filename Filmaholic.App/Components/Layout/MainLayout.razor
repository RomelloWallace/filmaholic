@inherits LayoutComponentBase
@implements IDisposable
@inject Filmaholic.App.Services.AuthService AuthService
@inject Filmaholic.App.Services.AuthenticationStateNotifier AuthenticationStateNotifier

<div class="layout-container">
    <header class="top-bar">
        @if (isAuthenticated)
        {
            <button class="menu-btn" @onclick="ToggleMenu" aria-label="@(showMenu ? "Close navigation" : "Open navigation")" aria-expanded="@showMenu">
                <span></span><span></span><span></span>
            </button>
        }
        <a class="brand-lockup" href="/movies" aria-label="Filmaholic home">
            <span class="brand-mark">F</span>
            <span class="brand-name">FILMAHOLIC<span class="brand-period">.</span></span>
        </a>
        @if (isAuthenticated)
        {
            <span class="topbar-note">THE MOVIE JOURNAL</span>
        }
    </header>

    <div class="content-wrapper">
        @if (isAuthenticated)
        {
            <div class="overlay @(showMenu ? "visible" : "")" @onclick="CloseMenu"></div>
            <div class="sidebar @(showMenu ? "open" : "")">
                <NavMenu OnNavigate="CloseMenu" />
            </div>
        }
        <main class="main-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool showMenu;
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateNotifier.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }

    private void HandleAuthenticationStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            StateHasChanged();
        });
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;
    }

    private void CloseMenu()
    {
        showMenu = false;
    }

    public void Dispose()
    {
        AuthenticationStateNotifier.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }
}