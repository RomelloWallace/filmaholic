@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Filmaholic</a>
    </div>
</div>

<div class="nav-scrollable">

    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/movies" @onclick="HandleNavigate">
                Movies
            </NavLink>
        </div>

        @if (isAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/movies/add" @onclick="HandleNavigate">
                    Add Movie
                </NavLink>
            </div>
        }

        @if (isAuthenticated)
        {
            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-start p-0" @onclick="HandleLogout">
                    Logout
                </button>
            </div>
        }

        @if (!isAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/login">
                    Login
                </NavLink>
            </div>
        }

        @if (!isAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/register">
                    Register
                </NavLink>
            </div>
        }

    </nav>
</div>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    [Inject]
    public AuthService AuthService { get; set; } = null!;

    [Inject]
    public AuthenticationStateNotifier AuthenticationStateNotifier { get; set; } = null!;

    [Inject]
    public NavigationManager Navigation { get; set; } = null!;

    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateNotifier.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        await CheckAuthState();
    }

    private void HandleAuthenticationStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await CheckAuthState();
            StateHasChanged();
        });
    }

    private async Task CheckAuthState()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }

    private async Task HandleNavigate()
    {
        await OnNavigate.InvokeAsync();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        await CheckAuthState();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthenticationStateNotifier.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }
}