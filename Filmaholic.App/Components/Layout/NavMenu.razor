@implements IDisposable

<div class="nav-panel">
    <p class="nav-label">YOUR SPACE</p>
    <nav class="side-nav" aria-label="Main navigation">
        @if (isAuthenticated)
        {
            <NavLink class="side-link" href="/movies" @onclick="HandleNavigate">
                <span class="side-link-icon" aria-hidden="true">01</span>
                <span>My collection</span>
            </NavLink>
            <NavLink class="side-link" href="/movies/add" @onclick="HandleNavigate">
                <span class="side-link-icon" aria-hidden="true">+</span>
                <span>Add a film</span>
            </NavLink>
            <button class="side-link side-link-button" @onclick="HandleLogout">
                <span class="side-link-icon" aria-hidden="true">↗</span>
                <span>Sign out</span>
            </button>
        }
        else
        {
            <NavLink class="side-link" href="/login">
                <span class="side-link-icon" aria-hidden="true">↪</span>
                <span>Sign in</span>
            </NavLink>
            <NavLink class="side-link" href="/register">
                <span class="side-link-icon" aria-hidden="true">+</span>
                <span>Create account</span>
            </NavLink>
        }
    </nav>

    @if (isAuthenticated)
    {
        <div class="sidebar-footnote">
            <span class="sidebar-spark" aria-hidden="true">✳</span>
            <p>Keep the films<br />that stay with you.</p>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    [Inject]
    public AuthService AuthService { get; set; } = null!;

    [Inject]
    public AuthenticationStateNotifier AuthenticationStateNotifier { get; set; } = null!;

    [Inject]
    public NavigationManager Navigation { get; set; } = null!;

    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateNotifier.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        await CheckAuthState();
    }

    private void HandleAuthenticationStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await CheckAuthState();
            StateHasChanged();
        });
    }

    private async Task CheckAuthState()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }

    private async Task HandleNavigate()
    {
        await OnNavigate.InvokeAsync();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        await CheckAuthState();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthenticationStateNotifier.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }
}