@page "/login"
@inject AuthService AuthService
@inject NavigationManager Nav
@using Filmaholic.Shared.Dtos
@using Microsoft.AspNetCore.Components

<section class="auth-page">
    <div class="auth-art" aria-hidden="true">
        <span class="auth-art-mark">F</span>
        <p>For the films<br />that stay with you.</p>
    </div>
    <div class="auth-form">
        <p class="eyebrow">WELCOME BACK</p>
        <h1>Sign in</h1>
        <p>Pick up where your collection left off.</p>

        <EditForm Model="loginRequest" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            <div class="form-field">
                <label for="login-username">Username</label>
                <InputText id="login-username" @bind-Value="loginRequest.UserName" class="form-control" autocomplete="username" />
            </div>
            <div class="form-field">
                <label for="login-password">Password</label>
                <InputText id="login-password" @bind-Value="loginRequest.Password" type="password" class="form-control" autocomplete="current-password" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-error" role="alert">@errorMessage</div>
            }

            <button type="submit" class="button button-primary" disabled="@isBusy">
                @(isBusy ? "Signing in..." : "Sign in to your shelf")
            </button>
        </EditForm>
        <p class="auth-switch">New to Filmaholic? <a href="/register">Create an account</a></p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private LoginRequestDto loginRequest = new();
    private string? errorMessage;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            Nav.NavigateTo(GetDestination());
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        isBusy = true;

        try
        {
            var (response, error) = await AuthService.LoginAsync(loginRequest);
            if (response is null)
            {
                errorMessage = error ?? "Invalid username or password.";
                return;
            }

            Nav.NavigateTo(GetDestination());
        }
        catch (Exception ex)
        {
            errorMessage = "Login failed. Please try again.";
            Console.WriteLine(ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    private string GetDestination()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl)
            && ReturnUrl.StartsWith('/')
            && !ReturnUrl.StartsWith("//"))
        {
            return ReturnUrl;
        }

        return "/movies";
    }
}
