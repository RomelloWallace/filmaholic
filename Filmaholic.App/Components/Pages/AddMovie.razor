@page "/movies/add"
@attribute [RequireAuthentication]
@inject MovieService MovieService
@inject NavigationManager Nav

@using Filmaholic.Shared.Dtos

<div class="form-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">GROW YOUR COLLECTION</p>
            <h1>Add a film</h1>
            <p class="heading-note">Save the details you want to remember.</p>
        </div>
    </div>

    <EditForm Model="@movie" OnValidSubmit="SaveMovie" class="form-panel">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-errors" />

        <div class="form-grid">
            <div class="form-field form-field-wide">
                <label for="movie-title">Film title</label>
                <InputText id="movie-title" @bind-Value="movie.Title" class="form-control" placeholder="e.g. In the Mood for Love" />
            </div>
            <div class="form-field">
                <label for="movie-genre">Genre</label>
                <InputText id="movie-genre" @bind-Value="movie.Genre" class="form-control" placeholder="Drama, comedy..." />
            </div>
            <div class="form-field">
                <label for="movie-age">Age group</label>
                <InputText id="movie-age" @bind-Value="movie.AgeGroup" class="form-control" placeholder="Audience rating" />
            </div>
            <div class="form-field">
                <label for="movie-year">Release year</label>
                <InputNumber id="movie-year" @bind-Value="movie.Year" class="form-control" placeholder="Optional" />
            </div>
            <div class="form-field form-field-wide">
                <label for="movie-description">Notes</label>
                <InputTextArea id="movie-description" @bind-Value="movie.Description" class="form-control" rows="5" placeholder="What made this one stay with you?" />
            </div>
            <div class="form-field form-field-wide">
                <label for="movie-image">Poster image <span class="field-optional">OPTIONAL</span></label>
                <div class="file-field">
                    <InputFile id="movie-image" OnChange="OnImageSelected" accept="image/*" />
                    @if (movie.Image is not null)
                    {
                        <p class="file-feedback">Image ready to save.</p>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="form-error" role="alert">@errorMessage</div>
        }

        <div class="form-actions">
            <button type="submit" class="button button-primary" disabled="@isBusy">@(isBusy ? "Saving..." : "Save to collection")</button>
            <button type="button" class="button button-secondary" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
</div>

@code {

    private CreateMovieDto movie = new CreateMovieDto();

    private bool isBusy;
    private string? errorMessage;

    private async Task SaveMovie()
    {
        errorMessage = null;
        isBusy = true;
        try
        {
            await MovieService.AddMovieAsync(movie);
            Nav.NavigateTo("/movies");
        }
        catch
        {
            errorMessage = "Could not save this film. Check your connection and try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            movie.Image = buffer.ToArray();
            errorMessage = null;
        }
        catch (IOException)
        {
            movie.Image = null;
            errorMessage = "Choose an image smaller than 10 MB.";
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/movies");
    }
}