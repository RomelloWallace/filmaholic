@page "/movies/add"
@inject MovieService MovieService
@inject NavigationManager Nav

@using Filmaholic.Shared.Dtos

<h3>Add Movie</h3>

<EditForm Model="@movie" OnValidSubmit="SaveMovie">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Title:</label>
        <InputText @bind-Value="movie.Title" class="form-control" />
    </div>

        <div class="form-group">
        <label>AgeGroup:</label>
        <InputText @bind-Value="movie.AgeGroup" class="form-control" />
    </div>

        <div class="form-group">
        <label>Genre:</label>
        <InputText @bind-Value="movie.Genre" class="form-control" />
    </div>

    <div class="form-group">
        <label>User Name:</label>
        <InputText @bind-Value="movie.UserName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Year:</label>
        <InputNumber @bind-Value="movie.Year" class="form-control" />
    </div>

    <div class="form-group">
        <label>Description:</label>
        <InputTextArea @bind-Value="movie.Description"
                       class="form-control"
                       rows="4" />
    </div>

    <div class="form-group">
        <label>Image:</label>
        <InputFile OnChange="OnImageSelected" />
        @if (movie.Image is not null)
        {
            <div class="mt-2">Image selected.</div>
        }
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>
</EditForm>

<button type="button"
        class="btn btn-secondary mt-3"
        @onclick="Cancel">
    Cancel
</button>

@if (submitted)
{
    <div class="alert alert-success mt-3">
        Movie saved!
    </div>
}

@code {

    private CreateMovieDto movie = new CreateMovieDto();

    private bool submitted;

    private async Task SaveMovie()
    {
        try
        {
            await MovieService.AddMovieAsync(movie);
            submitted = true;
            Nav.NavigateTo("/movies");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            submitted = false;
        }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var maxBytes = 10 * 1024 * 1024;
        await using var stream = file.OpenReadStream(maxBytes);
        var size = (int)Math.Min(file.Size, maxBytes);
        var buffer = new byte[size];
        var totalRead = 0;

        while (totalRead < size)
        {
            var read = await stream.ReadAsync(buffer, totalRead, size - totalRead);
            if (read == 0)
                break;
            totalRead += read;
        }

        if (totalRead != size)
        {
            Array.Resize(ref buffer, totalRead);
        }

        movie.Image = buffer;
    }

    private void Cancel()
    {
        Nav.NavigateTo("/movies");
    }
}