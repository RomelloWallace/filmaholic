@page "/register"
@inject AuthService AuthService
@inject NavigationManager Nav
@using Filmaholic.Shared.Dtos

<section class="auth-page">
    <div class="auth-art" aria-hidden="true">
        <span class="auth-art-mark">F</span>
        <p>A little more room<br />for good cinema.</p>
    </div>
    <div class="auth-form">
        <p class="eyebrow">START YOUR JOURNAL</p>
        <h1>Create account</h1>
        <p>Your next favorite film deserves a place here.</p>

        <EditForm Model="registerRequest" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            <div class="form-field">
                <label for="register-username">Username</label>
                <InputText id="register-username" @bind-Value="registerRequest.UserName" class="form-control" placeholder="Choose a username" autocomplete="username" />
            </div>
            <div class="form-field">
                <label for="register-email">Email</label>
                <InputText id="register-email" @bind-Value="registerRequest.Email" type="email" class="form-control" placeholder="you@example.com" autocomplete="email" />
            </div>
            <div class="form-field">
                <label for="register-password">Password</label>
                <InputText id="register-password" @bind-Value="registerRequest.Password" type="password" class="form-control" autocomplete="new-password" />
            </div>
            <div class="form-field">
                <label for="register-confirm">Confirm password</label>
                <InputText id="register-confirm" @bind-Value="registerRequest.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-error" role="alert">@errorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="form-error form-success" role="status">@successMessage</div>
            }

            <button type="submit" class="button button-primary" disabled="@isBusy">
                @(isBusy ? "Creating account..." : "Create your account")
            </button>
        </EditForm>
        <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
    </div>
</section>

@code {
    private RegisterRequestDto registerRequest = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            Nav.NavigateTo("/movies");
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = null;
        successMessage = null;
        isBusy = true;

        try
        {
            if (registerRequest.Password != registerRequest.ConfirmPassword)
            {
                errorMessage = "Passwords do not match.";
                return;
            }

            var (success, error) = await AuthService.RegisterAsync(registerRequest);
            
            if (!success)
            {
                errorMessage = error ?? "Registration failed. Please try again.";
                return;
            }

            successMessage = "Account created successfully! Redirecting to login...";
            await Task.Delay(2000);
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = "Registration failed. Please try again.";
            Console.WriteLine(ex);
        }
        finally
        {
            isBusy = false;
        }
    }
}
