@page "/register"
@inject AuthService AuthService
@inject NavigationManager Nav
@using Filmaholic.Shared.Dtos

<h3>Create Account</h3>

<EditForm Model="registerRequest" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Username</label>
        <InputText @bind-Value="registerRequest.UserName" class="form-control" placeholder="Choose a username" />
    </div>

    <div class="form-group">
        <label>Email</label>
        <InputText @bind-Value="registerRequest.Email" type="email" class="form-control" placeholder="your@email.com" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <InputText @bind-Value="registerRequest.Password" type="password" class="form-control" placeholder="Password" />
    </div>

    <div class="form-group">
        <label>Confirm Password</label>
        <InputText @bind-Value="registerRequest.ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isBusy">
        @(isBusy ? "Creating account..." : "Register")
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success mt-3">@successMessage</div>
}

<div class="mt-3">
    <p>Already have an account? <a href="/login">Login here</a></p>
</div>

@code {
    private RegisterRequestDto registerRequest = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            Nav.NavigateTo("/movies");
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = null;
        successMessage = null;
        isBusy = true;

        try
        {
            if (registerRequest.Password != registerRequest.ConfirmPassword)
            {
                errorMessage = "Passwords do not match.";
                return;
            }

            var (success, error) = await AuthService.RegisterAsync(registerRequest);
            
            if (!success)
            {
                errorMessage = error ?? "Registration failed. Please try again.";
                return;
            }

            successMessage = "Account created successfully! Redirecting to login...";
            await Task.Delay(2000);
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = "Registration failed. Please try again.";
            Console.WriteLine(ex);
        }
        finally
        {
            isBusy = false;
        }
    }
}
