@page "/movie/{Id:guid}/edit"
@inject MovieService MovieService
@inject NavigationManager Nav

@using Filmaholic.Shared.Dtos


<div class="form-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">YOUR COLLECTION</p>
            <h1>Edit film</h1>
            <p class="heading-note">Update the details in your journal.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state"><span class="loading-mark"></span><p>Loading film details...</p></div>
    }
    else
    {
        <EditForm Model="@movie" OnValidSubmit="SaveMovie" class="form-panel">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            <div class="form-grid">
                <div class="form-field form-field-wide">
                    <label for="movie-title">Film title</label>
                    <InputText id="movie-title" @bind-Value="movie.Title" class="form-control" />
                </div>
                <div class="form-field">
                    <label for="movie-genre">Genre</label>
                    <InputText id="movie-genre" @bind-Value="movie.Genre" class="form-control" />
                </div>
                <div class="form-field">
                    <label for="movie-age">Age group</label>
                    <InputText id="movie-age" @bind-Value="movie.AgeGroup" class="form-control" />
                </div>
                <div class="form-field">
                    <label for="movie-year">Release year</label>
                    <InputNumber id="movie-year" @bind-Value="movie.Year" class="form-control" />
                </div>
                <div class="form-field form-field-wide">
                    <label for="movie-description">Notes</label>
                    <InputTextArea id="movie-description" @bind-Value="movie.Description" class="form-control" rows="5" />
                </div>
                <div class="form-field form-field-wide">
                    <label for="movie-image">Replace poster <span class="field-optional">OPTIONAL</span></label>
                    <div class="file-field">
                        <InputFile id="movie-image" OnChange="OnImageSelected" accept="image/*" />
                        @if (movie.Image is not null)
                        {
                            <p class="file-feedback">A poster is attached to this film.</p>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-error" role="alert">@errorMessage</div>
            }

            <div class="form-actions">
                <button type="submit" class="button button-primary" disabled="@isBusy">@(isBusy ? "Saving..." : "Save changes")</button>
                <button type="button" class="button button-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }
    
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;
    private GetMovieDto movie = new GetMovieDto();
    
    private UpdateMovieDto updateMovie = new UpdateMovieDto();

    protected override async Task OnInitializedAsync()
    {
        var result = await MovieService.GetMovieAsync(Id);
        if (result == null)
        {
            Nav.NavigateTo("/movies");
            return;
        }

        movie = result;
        isLoading = false;
    }

    private async Task SaveMovie()
    {
        errorMessage = null;
        isBusy = true;
        updateMovie.Id = Id.ToString();
        updateMovie.Title = movie.Title;
        updateMovie.Genre = movie.Genre;
        updateMovie.AgeGroup = movie.AgeGroup;
        updateMovie.Year = movie.Year;
        updateMovie.Description = movie.Description;
        updateMovie.Image = movie.Image;
        try
        {
            await MovieService.UpdateMovieAsync(updateMovie);
            Nav.NavigateTo("/movies");
        }
        catch
        {
            errorMessage = "Could not save these changes. Check your connection and try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            movie.Image = buffer.ToArray();
            errorMessage = null;
        }
        catch (IOException)
        {
            errorMessage = "Choose an image smaller than 10 MB.";
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/movies");
    }
}